  "methods": {
    "_comment": "Matte per icon. u2net = rembg u2net + white-background refinement (default). flood = classical flood fill with translucent ground shadow, used for pale dioramas. flood_noshadow = flood without the baked shadow.",
    "default": "u2net",
    "byGroup": {
      "facility": "flood"
    },
    "byId": {
      "paper": "flood_noshadow",
      "forestry": "flood",
      "quarry": "flood",
      "sand_pit": "flood",
      "clay_pit": "flood",
      "limestone_mine": "flood"
    }
  },
  "margins": {
    "_comment": "Crop margin around a cell as a fraction of its size (default 0.12). 0 where two objects nearly touch across the cut line.",
